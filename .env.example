# Токен бота, полученный у @BotFather (обязательно)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Путь к файлу базы SQLite (относительный путь считается от каталога проекта)
DB_PATH=bot.db

# Путь к CSV с Oxford 3000 (используется для автоимпорта при первом запуске)
CSV_PATH=data/oxford3000_vocabulary_with_collocations_and_definitions_datasets.csv

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Файл логов (пустое значение — писать только в консоль)
LOG_FILE=logs/bot.log

# Часовой пояс по умолчанию (используется, пока пользователь не выбрал свой)
DEFAULT_TIMEZONE=Europe/Moscow
