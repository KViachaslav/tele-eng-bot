# Токен бота, полученный у @BotFather (обязательно)
# Для локальных запусков берите отдельного тестового бота: с одним токеном
# сервер и локальный процесс отбирают друг у друга getUpdates, и в логах
# появляется TelegramConflictError (409 Conflict), а бот «молчит».
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Путь к файлу базы SQLite (относительный путь считается от каталога проекта)
DB_PATH=bot.db

# Путь к CSV с Oxford 3000 (используется для автоимпорта при первом запуске)
CSV_PATH=data/oxford3000_vocabulary_with_collocations_and_definitions_datasets.csv

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Файл логов (пустое значение — писать только в консоль)
LOG_FILE=logs/bot.log

# Часовой пояс по умолчанию (используется, пока пользователь не выбрал свой)
DEFAULT_TIMEZONE=Europe/Moscow

# Перевод определений и примеров на русский (MyMemory API). Выключить можно так:
# TRANSLATION_ENABLED=false
TRANSLATION_ENABLED=true

# Почта для MyMemory (параметр de): с ней суточный лимит сервиса выше —
# ~50000 символов вместо ~5000. Нужна для пакетного перевода словаря
# (python scripts/translate_words.py), иначе он растянется на месяцы.
MYMEMORY_EMAIL=
