# Шаблон доступов к серверу для deploy/remote_deploy.py.
# Скопируйте в .deploy.env и впишите свои значения: тот файл в git не попадает
# (.gitignore), поэтому пароль SSH можно держать прямо в нём.
SSH_HOST=192.168.1.50
SSH_PORT=22
SSH_USER=your-ssh-user
SSH_PASSWORD=здесь-пароль-пользователя-ssh

# Каталог проекта на сервере, имя сервиса systemd и пользователь-владелец .env.
SSH_PROJECT_DIR=/opt/tele_eng
SSH_SERVICE=tele-eng-bot
SSH_RUN_USER=teleeng

# Почта для пакетного перевода (MyMemory): поднимает суточный лимит.
MYMEMORY_EMAIL=you@example.com
